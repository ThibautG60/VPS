Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8
AddType application/xml .xml
AddType text/plain .txt

RewriteEngine On

# Redirection HTTP vers HTTPS (sauf en local, et en respectant un éventuel reverse proxy)
# R=301 : Redirection permanente
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127(?:\.[0-9]{1,3}){3}|10(?:\.[0-9]{1,3}){3}|192\.168(?:\.[0-9]{1,3}){2}|172\.(?:1[6-9]|2[0-9]|3[01])(?:\.[0-9]{1,3}){2})(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Interdit l'accès direct aux dossiers internes et aux fichiers cachés (hors .well-known)
RewriteRule ^(utils|views)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Fichiers statiques servis tels quels (assets, robots.txt, sitemap.xml)
# L : Fin de règle | - : On ne change rien, pas de réécriture
RewriteRule ^assets/ - [L]
RewriteRule ^(robots\.txt|sitemap\.xml)$ - [L]

# Toutes les autres routes passent par le contrôleur frontal
# QSA : Conserve les paramètres de l'URL
RewriteRule ^(.*)$ index.php [L,QSA]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>